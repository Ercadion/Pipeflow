<resources>
    <!-- 밝은 테마 고정 (시안 기준): 연한 회청색 바탕 + 흰 카드 + 파란 강조 -->
    <style name="Theme.PipeFlow" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorPrimaryContainer">@color/brand_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_dark</item>
        <item name="colorSecondaryContainer">@color/brand_soft</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="materialButtonStyle">@style/Widget.PipeFlow.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.PipeFlow.Button.Outlined</item>
        <item name="textInputStyle">@style/Widget.PipeFlow.TextInput</item>
        <item name="actionBarStyle">@style/Widget.PipeFlow.ActionBar</item>
    </style>

    <style name="Theme.PipeFlow.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.PipeFlow.Fullscreen" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="android:windowFullscreen">true</item>
        <item name="materialButtonStyle">@style/Widget.PipeFlow.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.PipeFlow.Button.Outlined</item>
    </style>

    <style name="Widget.PipeFlow.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/bg</item>
        <item name="elevation">0dp</item>
        <item name="titleTextStyle">@style/TextAppearance.PipeFlow.BarTitle</item>
    </style>

    <style name="TextAppearance.PipeFlow.BarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="Widget.PipeFlow.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.PipeFlow.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="strokeColor">@color/brand</item>
        <item name="android:textColor">@color/brand</item>
    </style>

    <style name="Widget.PipeFlow.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/brand</item>
        <item name="boxBackgroundColor">@color/surface</item>
    </style>

    <!-- 흰 카드 (둥근 모서리 16dp, 연한 테두리) -->
    <style name="PipeFlow.Card" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- 안내 상자 (연한 파랑) -->
    <style name="PipeFlow.Note" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_note</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/brand_dark</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="PipeFlow.Section" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PipeFlow.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="PipeFlow.BigValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
