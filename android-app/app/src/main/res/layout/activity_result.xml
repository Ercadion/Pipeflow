<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="12dp">

        <io.github.ercadion.pipeflow.OverlayImageView
            android:id="@+id/imgOverlay"
            android:layout_width="match_parent" android:layout_height="420dp"
            android:background="#111111" android:scaleType="fitCenter" />

        <TextView android:id="@+id/txtHint" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:text="초록: 관 내경 · 빨강: 수면선" />

        <TextView android:id="@+id/txtMode" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:padding="8dp" android:background="#22888888" android:textSize="13sp" />

        <RadioGroup android:id="@+id/groupView" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:visibility="gone">
            <RadioButton android:id="@+id/viewAuto" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:text="자동" />
            <RadioButton android:id="@+id/viewCorr" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:text="수정" />
            <RadioButton android:id="@+id/viewBoth" android:layout_width="0dp"
                android:layout_weight="1" android:layout_height="wrap_content" android:text="비교" />
        </RadioGroup>

        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:indeterminate="true" android:visibility="gone" />
        <TextView android:id="@+id/txtProgress" android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView android:id="@+id/txtResult" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:textIsSelectable="true" android:textSize="15sp" />

        <!-- 저장 전 확인 단계에서만 보임 -->
        <LinearLayout android:id="@+id/boxReview" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="8dp" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="자동 결과가 틀렸으면 고치세요 (자동 결과는 그대로 함께 저장됩니다)" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnEdit" style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:text="수면선 수정" />
                <Button android:id="@+id/btnRedetect" style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:text="테두리 재검출" />
            </LinearLayout>
            <Button android:id="@+id/btnRevert" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="고친 것 버리고 자동 결과로" android:visibility="gone" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="측정 장소·관로 ID (필수 — 저장할 때 측정 폴더 이름에 들어가고, 저장 후에는 바꿀 수 없음)" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="측정 장소 (예: 서천동 우수관 3번 맨홀) — 다음 측정에 자동으로 채워짐">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editPlace" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="관로 ID (예: P-012) — 다음 측정에 자동으로 채워짐">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editPipe" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/txtLocation" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="12sp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="실측값 (알면 입력 — 저장 후에도 입력 가능, 학습 정답·버전 비교의 기준)" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="실측 수심 (mm, 자로 잰 값)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTruthDepth" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="numberDecimal|numberSigned" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="실측 평균유속 (m/s, 유량계 등)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTruthV" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="numberDecimal|numberSigned" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="실측 유량 (L/s)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editTruthQ" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:inputType="numberDecimal|numberSigned" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="참값 메모 (예: 자로 잰 수심 42mm, 유량계 0.31 m/s)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editNote" android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout android:id="@+id/boxSave" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="horizontal"
            android:layout_marginTop="8dp" android:visibility="gone">
            <Button android:id="@+id/btnDiscard" style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:text="삭제" />
            <Button android:id="@+id/btnSave" android:layout_width="0dp" android:layout_weight="2"
                android:layout_height="wrap_content" android:layout_marginStart="8dp"
                android:text="저장 (이후 결과 변경 불가)" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
