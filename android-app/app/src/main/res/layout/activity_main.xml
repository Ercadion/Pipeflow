<?xml version="1.0" encoding="utf-8"?>
<!-- 홈: 소개 · 진행 중인 정기 기록 · 최근 측정 · 빠른 시작 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="24dp"
            android:paddingBottom="20dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="34dp" android:layout_height="34dp"
                    android:src="@drawable/ic_drop" app:tint="@color/brand" android:contentDescription="PipeFlow" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PipeFlow" android:textColor="@color/brand" android:textSize="22sp"
                        android:textStyle="bold" />
                    <TextView style="@style/PipeFlow.Label"
                        android:text="Water Level &amp; Surface Velocity from Photos and Videos" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:lineSpacingExtra="2dp"
                android:text="관 속 물의\n수위와 유속을\n간편하게 측정하세요."
                android:textColor="@color/text_primary" android:textSize="25sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textColor="@color/text_secondary" android:textSize="13sp"
                android:text="관 끝단 사진·영상으로 수심, 유속, 유량을 계산하고\n고정 설치로 수위 변화를 기록합니다." />

            <!-- 멈춘 정기 기록 -->
            <LinearLayout android:id="@+id/boxRunning" style="@style/PipeFlow.Card"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/bg_note" android:visibility="gone"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_timeline" app:tint="@color/brand" android:contentDescription="정기 기록" />
                <TextView android:id="@+id/txtRunning" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginStart="10dp"
                    android:textColor="@color/brand_dark" android:textSize="13sp" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_chevron" app:tint="@color/brand" android:contentDescription="이어서 기록" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="최근 측정 결과" android:textColor="@color/text_primary"
                    android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/txtAll" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:padding="4dp" android:text="전체보기 ›"
                    android:textColor="@color/brand" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/recentList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:id="@+id/txtEmpty" style="@style/PipeFlow.Note"
                android:text="아직 측정 기록이 없습니다. 아래 [측정]으로 시작하세요." android:visibility="gone" />

            <TextView style="@style/PipeFlow.Section" android:text="빠른 시작" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout android:id="@+id/tileMeasure" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card" android:orientation="horizontal"
                    android:gravity="center_vertical" android:padding="14dp"
                    android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle" android:padding="9dp"
                        android:src="@drawable/ic_camera" app:tint="@color/brand" android:contentDescription="측정" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:text="측정\n(촬영)"
                        android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/tileMonitor" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card" android:orientation="horizontal"
                    android:gravity="center_vertical" android:padding="14dp"
                    android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="40dp" android:layout_height="40dp"
                        android:background="@drawable/bg_icon_circle" android:padding="9dp"
                        android:src="@drawable/ic_timeline" app:tint="@color/brand" android:contentDescription="정기 기록" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:text="정기 기록\n(고정 설치)"
                        android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/txtInfo" style="@style/PipeFlow.Label"
                android:layout_marginTop="20dp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
